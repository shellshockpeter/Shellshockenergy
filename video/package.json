{
  "name": "video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/media-parser": "^4.0.529",
    "@remotion/tailwind-v4": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529",
    "tailwindcss": "4.0.0",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@fontsource/teko": "^5.3.0",
    "@remotion/eslint-config-flat": "4.0.529",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "render:explainer": "remotion render Explainer out/explainer.mp4 --scale=1.5 --codec=h264 --crf=14 --x264-preset=slow --image-format=png --color-space=bt709",
    "render:reel": "remotion render FullReel out/full-reel.mp4 --scale=1.5 --codec=h264 --crf=14 --x264-preset=slow --image-format=png --color-space=bt709",
    "render:call:first": "remotion render CallOnVideoFirstHalf out/gym-call-first-half-with-ui.mp4 --scale=1.5 --codec=h264 --crf=16 --x264-preset=slow --image-format=png",
    "render:call:video": "remotion render CallOnVideo out/gym-call-with-ui.mp4 --scale=1.5 --codec=h264 --crf=16 --x264-preset=slow --image-format=png",
    "render:call": "remotion render CallOverlay out/call-overlay.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png --scale=1.5",
    "render:call:webm": "remotion render CallOverlay out/call-overlay.webm --codec=vp9 --pixel-format=yuva420p --image-format=png --scale=1.5",
    "render:numbered": "remotion render NumberedList out/numbered-list.mp4 --scale=1.5 --codec=h264 --crf=14 --x264-preset=slow --image-format=png --color-space=bt709",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css",
    "./src/brand/fonts.ts"
  ]
}
